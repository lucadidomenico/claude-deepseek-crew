#!/usr/bin/env bash
# ds-worker-batch — run several independent ds-worker tasks IN PARALLEL and wait for all of them
#                    esegue IN PARALLELO più compiti ds-worker indipendenti e aspetta che finiscano tutti
#   ds-worker-batch task1.md task2.md ...   (one file per task, touching different files / un file per compito, file diversi)
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$HERE/ds-i18n.sh"
case "${1:-}" in ""|-h|--help) sed -n '2,4p' "$0"; [ $# -eq 0 ] && exit 2; exit 0;; esac
# check every task file before starting anyone, so a typo never launches a developer
for f in "$@"; do
  [ -f "$f" ] || { t "ds-worker-batch: file del compito non trovato: $f" "ds-worker-batch: task file not found: $f" >&2; exit 2; }
done
TMP=$(mktemp -d); i=0; RC=0
for f in "$@"; do i=$((i+1)); "$HERE/ds-worker" -f "$f" > "$TMP/$i.out" 2>&1 & sleep 1; done
for job in $(jobs -p); do wait "$job" || RC=1; done
i=0; for f in "$@"; do i=$((i+1)); echo "##### task file: $f"; cat "$TMP/$i.out"; done
rm -rf "$TMP"; exit $RC
